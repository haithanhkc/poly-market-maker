# Chỉ là tên biến. Điền giá trị thật vào file .env trên máy của bạn. Không commit .env.
# Bảng điều khiển chỉ ghi BOT_SPLIT_SIZE và BOT_MAX_MARKETS.
# Clip, số bậc và các mức dừng lỗ được tính từ khối split.
# Bỏ comment một dòng nâng cao bên dưới khi muốn ghi đè công thức đó.
# Khóa bí mật không bao giờ được in ra.

# Số USDT tách mỗi phiên. Phải > 0 và không nhỏ hơn 5.
BOT_SPLIT_SIZE=25

# Số phiên tối đa mỗi lần bấm Chạy (1 đến 100).
BOT_MAX_MARKETS=3

# paper không gửi lệnh. live chỉ chạy khi bấm Chạy live và đã tick xác nhận.
BOT_MODE=paper

# --- Ghi đè nâng cao. Không hiện trên bảng điều khiển. ---
# Vốn khóa vào sổ cái. Bỏ trống thì vốn = 3 × split
# (họ giữ 2–3 split chồng nhau). Live dùng số dư USDT nếu đọc được.
# BOT_CAPITAL=

# Số cổ mỗi bậc. Bỏ trống thì clip = max(5, split × 10/750 làm tròn bội 5).
# BOT_CLIP_SIZE=

# Số bậc mỗi phía, 1 đến 10. Bỏ trống thì số clip vừa 9.32% split, tối đa 3.
# Split 25 và 50 → 1 bậc của 5 cổ.
# BOT_RUNGS=

# Tỷ lệ dừng lỗ trong ngày. Bỏ trống thì 182.3864 / (3 × 750).
# BOT_MAX_LOSS_FRACTION=

# Lỗ tối đa của một phiên. Bỏ trống thì split × 8.828/750.
# BOT_SESSION_STOP=

# Tách phiên sau trước bao nhiêu giây. Bỏ trống thì 300.
# Không tắt rao của phiên đang chạy.
# BOT_SPLIT_LEAD=

# testnet không cần API key. mainnet cần PREDICT_API_KEY và, sau này,
# PREDICT_ALLOW_MAINNET=yes. Mặc định là testnet. Đừng chạy mainnet từ máy này
# cho đến khi chủ repo đồng ý một lần chạy live.
PREDICT_NETWORK=testnet

# Khóa riêng dạng hex của ví ký. Process không in giá trị này.
PREDICT_PRIVATE_KEY=

# API key của predict.fun. Chỉ bắt buộc trên mainnet. Testnet để trống.
PREDICT_API_KEY=

# Không bắt buộc. Địa chỉ Predict Account (Kernel / ERC-1271) nếu USDT và
# token nằm ở smart account. Để trống thì dùng ví EOA ký trực tiếp.
# signatureType luôn là 0.
# PREDICT_ACCOUNT=

# Không bắt buộc. Chỉ khi chủ repo đã đồng ý một lần chạy mainnet.
# PREDICT_ALLOW_MAINNET=no
