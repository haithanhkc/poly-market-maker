# Chỉ là tên biến. Điền giá trị thật vào file .env trên máy của bạn. Không commit .env.
# Dòng BOT_* đè giá trị trong config JSON. Khóa bí mật không bao giờ được in ra.

# Vốn khóa vào sổ cái. Sàn lỗ = vốn * (1 - BOT_MAX_LOSS_FRACTION).
BOT_CAPITAL=59

# Số pUSD tách mỗi phiên. Phải > 0, không lớn hơn vốn, và không nhỏ hơn 5.
BOT_SPLIT_SIZE=25

# Số cổ mỗi bậc của thang giá. Tối thiểu 5, không lớn hơn khối split.
BOT_CLIP_SIZE=5

# Số bậc post-only mỗi phía (1 đến 10).
BOT_RUNGS=3

# Tỷ lệ dừng lỗ trong ngày. 0.20 trên vốn 59 là ngân sách 11.80, sàn 47.20.
BOT_MAX_LOSS_FRACTION=0.20

# Lỗ tối đa của một phiên trước khi gộp. 0 nghĩa là tắt giới hạn từng phiên.
BOT_SESSION_STOP=6

# Số phiên tối đa mỗi lần bấm Chạy (1 đến 100).
BOT_MAX_MARKETS=3

# paper không gửi lệnh. live chỉ chạy khi bấm Chạy live và đã tick xác nhận.
BOT_MODE=paper

# Khóa riêng dạng hex của ví ký. Process không in giá trị này.
POLY_PRIVATE_KEY=

# Địa chỉ giữ pUSD và token Up/Down.
# EOA: chính ví ký. Proxy, Safe, hoặc ví nạp: địa chỉ funder trong phần cài đặt Polymarket.
POLY_FUNDER=

# 0 EOA, 1 POLY_PROXY (Magic/email), 2 GNOSIS_SAFE, 3 POLY_1271 ví nạp.
POLY_SIGNATURE_TYPE=0

# Không bắt buộc. Để trống thì client chính thức tự suy ra API L2 từ ví ký.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Không bắt buộc với EOA. Cần khi gửi split/merge/redeem cho proxy, Safe, hoặc ví nạp.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
