# Chỉ là tên biến. Điền giá trị thật vào file .env trên máy của bạn. Không commit .env.
# Bảng điều khiển chỉ ghi BOT_SPLIT_SIZE và BOT_MAX_MARKETS.
# Clip, số bậc và các mức dừng lỗ được tính từ khối split.
# Bỏ comment một dòng nâng cao bên dưới khi muốn ghi đè công thức đó.
# Khóa bí mật không bao giờ được in ra.

# Số pUSD tách mỗi phiên. Phải > 0 và không nhỏ hơn 5.
BOT_SPLIT_SIZE=25

# Số phiên tối đa mỗi lần bấm Chạy (1 đến 100).
BOT_MAX_MARKETS=3

# paper không gửi lệnh. live chỉ chạy khi bấm Chạy live và đã tick xác nhận.
BOT_MODE=paper

# --- Ghi đè nâng cao. Không hiện trên bảng điều khiển. ---
# Vốn khóa vào sổ cái. Bỏ trống thì vốn = split × 59/25
# (split 25 → 59, split 50 → 118). Live dùng số dư pUSD nếu đọc được.
# BOT_CAPITAL=

# Số cổ mỗi bậc. Bỏ trống thì 5, và chỉ tăng theo bước 5 khi đã đủ 10 bậc.
# BOT_CLIP_SIZE=

# Số bậc mỗi phía, 1 đến 10. Bỏ trống thì khoảng 60% split chia cho clip.
# Split 25 → 3 bậc. Split 50 → 6 bậc.
# BOT_RUNGS=

# Tỷ lệ dừng lỗ trong ngày. Bỏ trống thì 0.20.
# Trên vốn 59 là ngân sách 11.80, sàn 47.20.
# BOT_MAX_LOSS_FRACTION=

# Lỗ tối đa của một phiên. Bỏ trống thì split × 6/25 (25 → 6, 50 → 12).
# BOT_SESSION_STOP=

# Khóa riêng dạng hex của ví ký. Process không in giá trị này.
POLY_PRIVATE_KEY=

# Địa chỉ giữ pUSD và token Up/Down.
# EOA: chính ví ký. Proxy, Safe, hoặc ví nạp: địa chỉ funder trong phần cài đặt Polymarket.
POLY_FUNDER=

# 0 EOA, 1 POLY_PROXY (Magic/email), 2 GNOSIS_SAFE, 3 POLY_1271 ví nạp.
POLY_SIGNATURE_TYPE=0

# Không bắt buộc. Để trống thì client chính thức tự suy ra API L2 từ ví ký.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Không bắt buộc với EOA. Cần khi gửi split/merge/redeem cho proxy, Safe, hoặc ví nạp.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
