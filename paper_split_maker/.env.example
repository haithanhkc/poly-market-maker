# Names only. Put real values in .env on your machine. Never commit .env.
# Paper mode does not read these.

# Hex private key of the signer. The process never prints this value.
POLY_PRIVATE_KEY=

# Address that holds pUSD and outcome tokens.
# EOA: the signer. Proxy, Safe, or deposit wallet: the funder shown in Polymarket settings.
POLY_FUNDER=

# 0 EOA, 1 POLY_PROXY (Magic/email), 2 GNOSIS_SAFE, 3 POLY_1271 deposit wallet.
POLY_SIGNATURE_TYPE=0

# Optional. If empty, the official client derives L2 API creds from the signer.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Optional. Required to submit split/merge/redeem for a proxy, Safe, or deposit wallet.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
